<rml>
<head>
	<title>MuEmu</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="muemu_panel.rcss"/>
</head>
<!-- MuEmu (fork): the shared window of the server's custom features (events, commands, jewel bank,
     rankings, rewards...). MuEmuPanel.cpp fills it: a title, an optional table and buttons. -->
<body class="native-text" data-model="muemu_panel">
	<div id="panel" class="muemu-panel">
		<div class="muemu-title">{{title}}</div>
		<div class="muemu-close btn" data-event-click="muemu_close">X</div>
		<div class="muemu-text" data-for="line : lines">{{line}}</div>
		<div class="muemu-table scroll-pane">
			<div class="muemu-row muemu-header" data-if="header.size > 0">
				<div class="muemu-cell" data-for="cell : header">{{cell}}</div>
			</div>
			<div class="muemu-row" data-for="row : rows" data-style-color="row.color == '' ? '#ffffff' : row.color">
				<div class="muemu-cell" data-for="cell : row.cells">{{cell}}</div>
				<div class="muemu-row-btn btn" data-for="button : row.buttons"
				     data-event-click="muemu_action(button.action)">{{button.label}}</div>
			</div>
		</div>
		<div class="muemu-buttons">
			<div class="muemu-btn btn" data-for="button : buttons"
			     data-event-click="muemu_action(button.action)">{{button.label}}</div>
		</div>
	</div>
</body>
</rml>
