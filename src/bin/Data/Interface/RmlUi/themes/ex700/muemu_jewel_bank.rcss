/* MuEmu (fork): the jewel bank's EX700 look (Main.dll CustomJewelBank.cpp, CustomInterfaceType 2-4): the whole
   window is GFx/popup_bg_big01, the close X is Transcur. The art is the MuEmu client's Data/Custom/Interface. */
@spritesheet jb-popup-sheet { src: "../../../../Custom/Interface/GFx/popup_bg_big01.tga"; jb-popup: 0px 0px 1024px 1024px; }
@spritesheet jb-x-sheet     { src: "../../../../Custom/Interface/Transcur.tga"; jb-x: 0px 0px 29px 29px; jb-x-hover: 0px 29px 29px 29px; }

/* The rows, buttons and pager, in the window's own units (dp), where CustomJewelBank::DrawJewelBankWindow()
   drew them, widened to 300 so the names fit: rows from y 40 every 22, the name right-aligned up to x 110,
   the jewel at 113, the amount box (CheckBox.tga) at 134 and the five withdraw buttons from 182 every 18; the
   hint at 265 and the pager centred at y 277. */
#panel {
	position: absolute;
	left: 50%;
	top: 70dp;
	margin-left: 20dp;
	width: 300dp;
	height: 315dp;
	color: #ffffff;
	font-family: "token(font-body)";
	font-size: 9dp;
	pointer-events: auto;
}
#jb_title {
	position: absolute;
	left: 0;
	width: 300dp;
	text-align: center;
	color: #ffd23c;
	font-weight: bold;
	font-size: 10dp;
	cursor: move;
}
#jb_close { position: absolute; cursor: pointer; pointer-events: auto; }
#jb_message { position: absolute; left: 0; top: 120dp; width: 300dp; text-align: center; color: #ffd23c; }
#jb_rows { position: absolute; left: 0; top: 40dp; width: 300dp; }
.jb-row { display: block; position: relative; height: 22dp; }
.jb-name {
	position: absolute;
	left: 2dp;
	top: 3dp;
	width: 108dp;
	text-align: right;
	white-space: nowrap;
	color: #ffffff;
}
.jb-row.empty .jb-name { color: #9a9a9a; }
.jb-icon { position: absolute; left: 113dp; top: 0dp; width: 18dp; height: 20dp; pointer-events: none; }
.jb-count {
	position: absolute;
	left: 134dp;
	top: 2dp;
	width: 44dp;
	height: 16dp;
	decorator: image(jb-count);
}
.jb-count-text {
	display: block;
	width: 42dp;
	line-height: 16dp;
	text-align: right;
	color: #ffd23c;
	font-size: 8dp;
	white-space: nowrap;
}
.jb-row.empty .jb-count-text { color: #9a9a9a; }
.jb-buttons { position: absolute; left: 182dp; top: 2dp; width: 100dp; height: 16dp; }
.jb-btn {
	display: inline-block;
	width: 16dp;
	height: 16dp;
	margin-right: 2dp;
	line-height: 15dp;
	text-align: center;
	font-size: 7dp;
	color: #ffffff;
	background-color: rgba(20, 16, 10, 230);
	border-width: 1dp;
	border-color: #8a7444;
	cursor: pointer;
	pointer-events: auto;
}
.jb-btn:hover { color: #ffd23c; background-color: rgba(70, 58, 30, 240); }
#jb_hint { position: absolute; left: 0; top: 265dp; width: 300dp; text-align: center; color: #3cff3c; font-weight: bold; }
#jb_prev, #jb_next {
	position: absolute;
	top: 277dp;
	width: 20dp;
	height: 18dp;
	line-height: 18dp;
	text-align: center;
	color: #ffd23c;
	font-size: 12dp;
	cursor: pointer;
	pointer-events: auto;
}
#jb_prev { left: 100dp; }
#jb_next { left: 180dp; }
#jb_prev:hover, #jb_next:hover { color: #ffffff; }
#jb_page {
	position: absolute;
	left: 125dp;
	top: 277dp;
	width: 50dp;
	height: 18dp;
	line-height: 18dp;
	text-align: center;
	color: #ffffff;
	background-color: rgba(0, 0, 0, 160);
	border-width: 1dp;
	border-color: #6b5a3a;
	border-radius: 7dp;
}

@spritesheet jb-count-sheet { src: "../../../../Custom/Interface/CheckBox.tga"; jb-count: 0px 0px 32px 16px; }

#panel { decorator: image(jb-popup); }
#jb_frame_top, #jb_frame_body { display: none; }
#jb_title { top: 19dp; }
#jb_close { left: 279dp; top: 21dp; width: 14dp; height: 16dp; decorator: image(jb-x); }
#jb_close:hover { decorator: image(jb-x-hover); }
